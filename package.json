{
  "name": "aet-ski",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "jest",
    "test:ci": "jest --ci --coverage",
    "test:performance": "jest --testPathPattern=performance",
    "test:components": "jest --testPathPattern=components",
    "cypress": "cypress open",
    "cypress:run": "cypress run",
    "upload:logos": "node --env-file=.env.local --experimental-fetch --experimental-global-webcrypto scripts/upload-cloudinary-logos.mjs",
    "favicon": "node scripts/generate-favicon.js",
    "migrate-links": "tsx --env-file=.env.local scripts/migrate-links-to-sanity.ts",
    "migrate-all": "tsx --env-file=.env.local scripts/migrate-all-categories.ts",
    "migrate:terms": "tsx --env-file=.env.local scripts/migrate-terms-to-sanity.ts",
    "lighthouse": "lighthouse http://localhost:3000 --output=html --output-path=./lighthouse-report.html",
    "lighthouse:ci": "lhci autorun",
    "perf:test": "npm run build && npm run start & sleep 10 && npm run lighthouse && pkill -f 'next start'",
    "perf:mobile": "lighthouse http://localhost:3000 --emulated-form-factor=mobile --output=html --output-path=./lighthouse-mobile-report.html",
    "pagespeed": "node scripts/pagespeed-insights.js",
    "webpagetest": "node scripts/webpagetest.js",
    "migrate": "node scripts/migration-strategy.js",
    "migrate:safe": "node scripts/migration-strategy.js --continue-on-failure",
    "rollback:setup": "node scripts/rollback-plan.js",
    "rollback:list": "node scripts/rollback-plan.js --list",
    "validate:performance": "node scripts/performance-validation.js",
    "perf:full": "npm run lighthouse:ci && npm run pagespeed && npm run webpagetest"
  },
  "dependencies": {
    "@sanity/client": "^7.8.1",
    "@sanity/image-url": "^1.1.0",
    "@sanity/vision": "^4.3.0",
    "autoprefixer": "^10.4.21",
    "cloudinary": "^2.7.0",
    "clsx": "^2.1.1",
    "flag-icons": "^7.5.0",
    "jspdf": "^3.0.1",
    "lucide-react": "^0.533.0",
    "maptiler-js": "^1.1.3",
    "motion": "^12.23.12",
    "next": "15.4.4",
    "next-sanity": "^10.0.10",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "sanity": "^4.3.0",
    "styled-components": "^6.1.19",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@lhci/cli": "^0.12.0",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cypress": "^14.5.3",
    "eslint": "^9",
    "eslint-config-next": "15.4.4",
    "jest": "^30.0.5",
    "jest-environment-jsdom": "^30.0.5",
    "lighthouse": "^12.0.0",
    "puppeteer": "^23.0.0",
    "sharp": "^0.34.3",
    "svg-to-ico": "^1.0.17",
    "tsx": "^4.20.5",
    "typescript": "^5"
  }
}
